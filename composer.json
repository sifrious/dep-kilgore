{
    "name": "sifrious/kilgore",
    "description": "Evidence-backed interpretation of project history for Laravel applications.",
    "keywords": [
        "laravel",
        "history",
        "interpretation",
        "timelines",
        "evidence"
    ],
    "homepage": "https://github.com/sifrious/kilgore",
    "license": "proprietary",
    "authors": [
        {
            "name": "sifrious",
            "email": "mmebit@icloud.com"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Kilgore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Kilgore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\Kilgore\\KilgoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
